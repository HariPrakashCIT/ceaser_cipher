#include <iostream>
#include <string>
#include <limits>

using namespace std;

string caesarCipher(const string& text, int shift, const string& mode) {
    if (mode != "encrypt" && mode != "decrypt") {
        throw invalid_argument("Mode must be 'encrypt' or 'decrypt'.");
    }

    if (mode == "decrypt") {
        shift = -shift;
    }

    string result = text;

    for (char& ch : result) {
        if (ch >= 'A' && ch <= 'Z') {
            ch = static_cast<char>((ch - 'A' + shift % 26 + 26) % 26 + 'A');
        } else if (ch >= 'a' && ch <= 'z') {
            ch = static_cast<char>((ch - 'a' + shift % 26 + 26) % 26 + 'a');
        }
    }

    return result;
}

int main() {
    cout << "--- Caesar Cipher CLI Tool ---\n";

    string mode;
    while (true) {
        cout << "Choose mode (encrypt / decrypt): ";
        cin >> mode;

        if (mode == "encrypt" || mode == "decrypt") {
            break;
        }

        cout << "Invalid choice. Please type 'encrypt' or 'decrypt'.\n";
    }

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    string message;
    cout << "Enter your message: ";
    getline(cin, message);

    int shift;
    while (true) {
        cout << "Enter shift value (integer, e.g., 3): ";
        if (cin >> shift) {
            break;
        }

        cout << "Please enter a valid whole number.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    string processedText = caesarCipher(message, shift, mode);

    cout << "\nResulting " << mode << "ed text:\n";
    cout << processedText << '\n';

    return 0;
}
